    text-decoration: underline;
  }
  a[href]:hover,  #onetrust-pc-btn-handler:hover {
    color: var(--color-link-hover);
  }

  &.otFloatingRoundedCorner {
    font-size: 14px;

    background-color: var(--color-white);

    border-top-left-radius: 8px;
    border-top-right-radius: 8px;

    bottom: 20px;
    box-shadow: 0 8px 16px 0 #00000029;
    left: auto;
    padding: 24px;
    position: fixed;
    right: 20px;
    width: 480px;
    max-width: unset;

    &:focus {
      outline: none;
    }
    @media only screen and (max-width: 767px) {
      &.ot-bottom-right {
        box-sizing: border-box;
        width: 100%;
        bottom: 0;
        left: 0;
        right: 0;
      }
    }
    @media (min-width: 768px) {
      border-bottom-right-radius: 8px;
      border-bottom-left-radius: 8px;
    }
  }

  .ot-sdk-container {
    display: block;
    position: initial;
  }

  .banner-actions-container {
    margin-top: 24px;
  }

  .banner-actions-container {
    --button-gap: 8px;
    display: flex;
    flex-wrap: wrap;
    gap: var(--button-gap);

   & #onetrust-pc-btn-handler, & #onetrust-accept-btn-handler, & #onetrust-reject-all-handler {
     letter-spacing: unset;
   }

    & #onetrust-accept-btn-handler, & #onetrust-reject-all-handler {
      width: unset;
    }

    & > * {
      /* GDPR suggests that we shouldn't make a consent button more prominent than
      * the other. For this reason, we want to ensure that both buttons will take
      * up the same amount of space. If texts for the buttons don't allow for the
      * two buttons to be on the same row, we ensure that each takes up a full
      * row.
      */
      min-width: calc(50% - var(--button-gap) / 2);
      flex-grow: 1;
    }
  }

  #onetrust-accept-btn-handler, #onetrust-reject-all-handler {
    margin: 0;

    --height-small: 32px;
    font-size: var(--text-m-font-size);
    height: var(--height-small);
    line-height: calc(var(--height-small) - var(--vertical-border));
    padding: 0px 11px;

    --button-primary-background-color-hover: #222;
    --button-primary-background-color: var(--color-black);
    --button-primary-gradient-background-color: #ffffff1a;
    --button-primary-text-color: var(--color-white);
    --button-border-radius: 8px;
    --button-gradient-start: #0000 50%;
    --vertical-border: 2px;
    fill: currentColor;
    background-origin: border-box;
    border: 1px solid #0000;
    border-radius: var(--button-border-radius);
    cursor: pointer;
    display: inline-block;
    font-weight: 500;
    text-align: center;
    transition: all var(--transition-speed-base) ease-in-out;
    user-select: none;
    white-space: nowrap;

    box-shadow: 0 1px 1px #00000014;
    background-color: var(--button-primary-background-color);

    background-image: linear-gradient(to top,var(--button-gradient-start),var(--button-primary-gradient-background-color) 100%);
    color: var(--button-primary-text-color);
  }

  #onetrust-button-group {
    text-align: inherit;
  }

  #onetrust-policy-text, #onetrust-button-group-parent {
    padding: 0px;
  }

  #onetrust-policy, &.ot-wo-title #onetrust-group-container {
    margin-top: unset;
  }

  .banner-header {
    display: none;
  }

  #onetrust-pc-btn-handler {
    border: none;
    padding: 0;
    margin: 12px 0px 0px 0px;
    width: max-content;
    color: var(--link-text-color);
    transition: var(--link-transition);
    text-decoration: underline;
    font-weight: 400;
  }

  #onetrust-policy-text {
    padding-right: 8px;
  }

  #onetrust-policy-text, #onetrust-pc-btn-handler {
    font-size: var(--text-m-font-size);
  }

  #onetrust-close-btn-container {
    top: 0px;
    right: 0px;
  }
}#onetrust-pc-sdk .ot-go-group{border:1px solid #d8d8d8 !important;border-radius:1px;margin-bottom:15px !important;float:left;width:calc(100% - 2px)}#onetrust-pc-sdk .ot-go-section-header{float:left;padding-bottom:10px;font-size:1em;width:100%;font-weight:bold;color:#333;text-align:left;margin:0}.ot-go-modal-error-msg:empty{margin:0;line-height:0}#onetrust-pc-sdk div.ot-go-modal-overlay:not(.ot-hide){background:rgba(0,0,0,.5);z-index:2147483648;width:100%;height:100%;overflow:hidden;position:fixed;top:0;left:0}#onetrust-pc-sdk div.ot-go-modal-overlay:not(.ot-hide) .ot-go-modal{display:flex;flex-direction:column;overflow:hidden;position:relative;margin:5% auto;width:440px;max-width:90%;max-height:90vh;border-radius:8px;z-index:2147483649;background-color:#fff;box-shadow:0 4px 24px rgba(0,0,0,.15)}#onetrust-pc-sdk div.ot-go-modal-overlay:not(.ot-hide) .ot-go-modal-header{display:flex;justify-content:flex-end;align-items:center;padding:12px 16px}#onetrust-pc-sdk div.ot-go-modal-overlay:not(.ot-hide) .ot-go-modal-header .ot-go-modal-close{width:44px;height:44px;background-size:12px;margin:-18px -18px 0 0;border:none;display:inline-block;padding:0;background-repeat:no-repeat;background-position:center;position:absolute;top:1em;cursor:pointer}#onetrust-pc-sdk div.ot-go-modal-overlay:not(.ot-hide) .ot-go-modal-body{padding:0 28px 28px;overflow-y:auto}#onetrust-pc-sdk div.ot-go-modal-overlay:not(.ot-hide) .ot-go-modal-title{font-size:1.25em;font-weight:700;margin-bottom:12px;text-align:center}#onetrust-pc-sdk div.ot-go-modal-overlay:not(.ot-hide) .ot-go-modal-desc{font-size:.88em;margin:0 0 20px;line-height:1.5;text-align:center}#onetrust-pc-sdk div.ot-go-modal-overlay:not(.ot-hide) .ot-go-modal-input-wrapper{position:relative;margin-bottom:4px}#onetrust-pc-sdk div.ot-go-modal-overlay:not(.ot-hide) .ot-go-modal-input-wrapper .ot-go-modal-email{width:100%;padding:10px 36px 10px 12px;border:1px solid #d8d8d8;border-radius:4px;font-size:.95em;outline:none;box-sizing:border-box